// ─── Phase 9 — Enterprise Fee Architecture (DB-backed) ───────────────
//
// The fee-store has been in-memory + Zustand-persist (localStorage) since
// takeover. These new models make the fee system truly DB-backed and
// multi-tenant-safe, and let the webhook route auto-reconcile instead of
// just logging. All new models are ADDITIVE — the existing Fee + Payment
// models remain untouched so the legacy /api/fees route keeps working.
//
// Architectural mapping (store type → DB row):
//   - school-settings-store.fees.feeHeads[]  → MasterFeeHead
//   - fee-store.FEE_STRUCTURES[]             → FeeStructure (+ FeeHead rows)
//   - fee-store.FeeStructureVersion          → FeeStructureVersion
//   - fee-store.SEED_TRANSACTIONS[]          → FeeTransaction (immutable)
//   - fee-store.settlements[]                → Settlement
//   - fee-store.reconciliations[]            → Reconciliation
//   - fee-store.webhookEvents[]              → WebhookEvent
//
// Settlement status lifecycle:
//   pending → settled → reconciled
//                     ↘ exception → (manual review) → reconciled
//   failure → reversed

/// School-wide master fee-head catalogue — single source of truth for
/// head names, default frequencies, default amounts, categories.
/// Picked from when building per-class fee structures.
model MasterFeeHead {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  category    String   @default("Other") // Tuition, Admission, Annual, Transport, Lab, Library, Exam, Activity, Board, Other
  frequency   String   @default("Monthly") // Annual, Half-Yearly, Quarterly, Monthly, Per Term, One-Time
  amount      Float    @default(0)
  mandatory   Boolean  @default(true)
  active      Boolean  @default(true)
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Per-structure line items bound to this catalogue entry (read model).
  structures FeeHead[]

  @@unique([schoolId, name])
}

/// Per-class fee structure — one per (schoolId, classId). The effective
/// structure for a class is the one with status='current'. Drafts and
/// scheduled future structures live alongside as status='draft' or
/// 'scheduled'. Archived structures keep status='archived'.
model FeeStructure {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId        String
  className      String
  classLevel     String    @default("Primary") // Pre-Primary, Primary, Middle, Secondary, Senior Secondary
  status         String    @default("draft") // draft, current, scheduled, archived
  version        Int       @default(1)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  publishedAt    DateTime?
  archivedAt     DateTime?
  archivedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  heads        FeeHead[]
  versions     FeeStructureVersion[]
  transactions FeeTransaction[]

  @@unique([schoolId, classId, status])
  @@index([schoolId, status])
}

/// Per-structure line item — snapshot of a master catalogue entry at the
/// time of structure creation. Editing the master catalogue doesn't
/// retroactively change existing structures (versioning integrity).
model FeeHead {
  id          String         @id @default(cuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  structureId String
  structure   FeeStructure   @relation(fields: [structureId], references: [id], onDelete: Cascade)
  /// Optional link back to the master catalogue entry. NULL means this
  /// head was custom-typed by the principal and is uncatalogued.
  catalogueId String?
  catalogue   MasterFeeHead? @relation(fields: [catalogueId], references: [id], onDelete: SetNull)
  name        String
  category    String         @default("Other")
  amount      Float          @default(0)
  frequency   String         @default("Monthly")
  mandatory   Boolean        @default(true)
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([schoolId, structureId])
  @@index([schoolId, catalogueId])
}

/// Immutable snapshot of a fee structure at the moment it was published.
/// Used for historical audit (a published structure can never be edited —
/// only superseded by a new version that becomes 'current').
model FeeStructureVersion {
  id          String       @id @default(cuid())
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  structureId String
  structure   FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  version     Int
  /// JSON snapshot of the entire FeeStructureConfig (heads + examFees +
  /// meta) at publish time. Kept as a single JSON column so we don't
  /// need a parallel FeeHeadVersion table.
  snapshot    String
  publishedAt DateTime     @default(now())
  publishedBy String?
  notes       String?

  @@index([schoolId, structureId])
}

/// Immutable financial transaction — every payment event is recorded here
/// for audit + reconciliation. Updates to Fee.paid remain on the legacy
/// Fee model; this table is the source of truth for finance reports.
model FeeTransaction {
  id                   String           @id @default(cuid())
  schoolId             String
  school               School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId            String?
  studentName          String?
  className            String?
  structureId          String?
  structure            FeeStructure?    @relation(fields: [structureId], references: [id], onDelete: SetNull)
  feeHeadName          String?
  amount               Float
  method               String           @default("CASH") // UPI, Card, Net Banking, Cash, Bank Transfer
  status               String           @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED, UNDER_VERIFICATION
  /// Gateway order id (e.g. Razorpay order_id) — used by the webhook
  /// to match the incoming payment.payment_id event back to this row.
  gatewayOrderId       String?          @unique
  gatewayPaymentId     String?
  gatewaySignature     String?
  gatewayName          String? // razorpay, cashfree, payu, manual
  settlementId         String?
  settlement           Settlement?      @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  reconciliationStatus String           @default("unreconciled") // unreconciled, reconciled, pending, exception
  reconciliationNote   String?
  reconciledAt         DateTime?
  reconciledBy         String?
  receiptNo            String?
  note                 String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  reconciliations      Reconciliation[]

  @@index([schoolId, status])
  @@index([schoolId, reconciliationStatus])
  @@index([schoolId, createdAt])
}

/// Gateway payout settlement — a batch of transactions the gateway
/// paid out to the school's bank account on a given date.
model Settlement {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payoutId      String?   @unique // gateway payout id (e.g. Razorpay settlement_id)
  gatewayName   String? // razorpay, cashfree, payu, manual
  periodStart   DateTime
  periodEnd     DateTime
  grossAmount   Float
  fees          Float     @default(0)
  netAmount     Float
  status        String    @default("pending") // pending, settled, failed, reversed
  bankReference String?
  paidOutAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transactions FeeTransaction[]

  @@index([schoolId, status])
  @@index([schoolId, periodStart])
}

/// Reconciliation audit row — matches a FeeTransaction against a
/// Settlement (or against a manual bank statement entry). One row per
/// match attempt (a transaction can be rematched after exceptions).
model Reconciliation {
  id            String         @id @default(cuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   FeeTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  settlementId  String?
  status        String         @default("pending") // reconciled, unreconciled, pending, exception
  matchedAt     DateTime       @default(now())
  matchedBy     String?
  note          String?

  @@index([schoolId, transactionId])
}

/// Idempotent webhook event log — every incoming webhook is recorded
/// here FIRST, then processed. The unique eventId means a duplicate
/// webhook delivery is a no-op (idempotency).
model WebhookEvent {
  id                   String    @id @default(cuid())
  schoolId             String?
  school               School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  eventId              String    @unique // gateway event_id — used for idempotency
  eventType            String // payment.captured, payment.failed, settlement.processed
  gatewayName          String    @default("razorpay")
  signature            String?
  rawPayload           String // full JSON body
  status               String    @default("received") // received, processing, processed, error, duplicate
  matchedTransactionId String?
  error                String?
  receivedAt           DateTime  @default(now())
  processedAt          DateTime?

  @@index([schoolId, status])
  @@index([eventType])
}

/// RB-1 — Study Materials: the school's server-authorized repository of
/// learning resources (worksheets, notes, syllabi, sample papers, revision
/// packs). Metadata lives here; the bytes live under db/uploads/study-materials/
/// and are ONLY ever served through the authorized download route (never
/// statically). subjectId is a loose FK into Subject.id (string cuid).
model StudyMaterial {
  id           String    @id @default(cuid())
  schoolId     String
  title        String
  description  String?
  subjectId    String?
  className    String?
  category     String    @default("general") // general | worksheet | notes | syllabus | sample-paper | revision
  fileName     String // generated safe name on disk (cuid + extension)
  originalName String // user-facing name for Content-Disposition
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// L2D — publication lifecycle (spec §33): draft | published | archived.
  /// Students only ever see `published` + authorized rows.
  status      String    @default("published")
  /// Set when the row is (re-)published; null while a draft stays unseen.
  publishedAt DateTime?

  targets     StudyMaterialTarget[]
  activities  LearningActivity[]
  bookmarks   LearningBookmark[]

  @@index([schoolId, category])
  @@index([schoolId, createdAt])
  @@index([schoolId, status])
}

// ─────────────────────────────────────────────────────────────────────
// L2D — LEARNING EXPERIENCE 2.0 (spec: Learning is the student's academic
// hub — Overview / Flashcards / Planner / Groups, real data only).
// StudyMaterial above stays the SINGLE source of truth for learning
// resources (spec §54/§56/§57 — no duplicate resource models); the models
// below add per-student learning state on top of it.
// ─────────────────────────────────────────────────────────────────────

/// Specific-student targeting on top of StudyMaterial.className (null =
/// whole school, a class label = that class). A row here grants exactly one
/// student access to exactly one material (teacher/principal assigned).
model StudyMaterialTarget {
  id              String        @id @default(cuid())
  studyMaterialId String
  studyMaterial   StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([studyMaterialId, studentId])
  @@index([studentId])
}

/// Real "opened / completed" activity per student per material — powers
/// Continue Learning, Recently Opened and honest completion counts.
model LearningActivity {
  id              String        @id @default(cuid())
  schoolId        String
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studyMaterialId String
  studyMaterial   StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  openedAt        DateTime      @default(now())
  lastOpenedAt    DateTime      @default(now())
  completedAt     DateTime?

  @@unique([studentId, studyMaterialId])
  @@index([schoolId, studentId])
  @@index([studentId, lastOpenedAt])
}

/// Bookmarked resources (spec §17 — persists across sessions, one row per
/// student per material).
model LearningBookmark {
  id              String        @id @default(cuid())
  schoolId        String
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studyMaterialId String
  studyMaterial   StudyMaterial @relation(fields: [studyMaterialId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())

  @@unique([studentId, studyMaterialId])
  @@index([schoolId, studentId])
}

/// Flashcard deck (school-scoped; optional subject identity).
model FlashcardDeck {
  id          String          @id @default(cuid())
  schoolId    String
  subjectId   String?
  subject     Subject?        @relation(fields: [subjectId], references: [id])
  name        String
  description String?
  createdAt   DateTime        @default(now())

  cards        FlashcardCard[]
  reviewStates FlashcardReviewState[]

  @@index([schoolId])
}

/// One card in a deck; `position` gives a stable study order.
model FlashcardCard {
  id      String   @id @default(cuid())
  deckId  String
  deck    FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front   String
  back    String
  position Int     @default(0)

  reviewStates FlashcardReviewState[]

  @@index([deckId])
}

/// SM-2-lite spaced-repetition state per student per card — the server is
/// the ONLY place ease/interval/dueAt are computed (spec §22: track real
/// review state; never pretend).
model FlashcardReviewState {
  id             String        @id @default(cuid())
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cardId         String
  card           FlashcardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  deckId         String
  deck           FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  ease           Float         @default(2.5)
  intervalDays   Int           @default(0)
  dueAt          DateTime      @default(now())
  reps           Int           @default(0)
  lapses         Int           @default(0)
  lastReviewedAt DateTime?

  @@unique([studentId, cardId])
  @@index([studentId, dueAt])
  @@index([deckId, studentId])
}

/// Personal study planner task (spec §23/§24) — real CRUD, real due dates,
/// real completion. Optional subject link is the "resource-linked" hook.
model StudyTask {
  id          String    @id @default(cuid())
  schoolId    String
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([schoolId, studentId])
  @@index([studentId, dueDate])
}

/// Study group (school-scoped). Academic identity only — no social ranking,
/// no helpfulness scores (spec §26).
model StudyGroup {
  id          String   @id @default(cuid())
  schoolId    String
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  name        String
  description String
  createdAt   DateTime @default(now())

  members   StudyGroupMember[]
  questions StudyGroupQuestion[]

  @@index([schoolId])
}

/// Membership row (one per student per group) — powers REAL member counts.
model StudyGroupMember {
  id        String     @id @default(cuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([groupId, studentId])
  @@index([studentId])
}

/// A student question inside a group. Lands PENDING and stays invisible to
/// classmates until a teacher/principal publishes it (spec §29 moderation).
model StudyGroupQuestion {
  id        String     @id @default(cuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  schoolId  String
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question  String
  status    String     @default("pending") // pending | published | hidden
  createdAt DateTime   @default(now())

  @@index([groupId, status])
  @@index([schoolId])
}

// =====================================================================
// TEACHER HUB — Parent Connect / Student Behavior / Student Mentoring
// (v2.14). All rows are tenant-owned (schoolId) and every query path
// resolves the authenticated teacher server-side (src/lib/teacher-hub.ts).
// SQLite: no enums/Json — status/category values are documented strings.
// =====================================================================

/// One teacher ↔ one guardian ↔ one student school-communication thread.
/// Deliberately separate from the flat `Message` model (inbox mail) — this
/// carries conversational state: category, pinning, follow-up linkage and
/// per-message read receipts.
model ParentConversation {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// User.id of the teacher participant
  teacherId     String
  teacher       User      @relation("ParentConversationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  /// User.id of the guardian participant (User.role = PARENT)
  parentId      String
  parent        User      @relation("ParentConversationParent", fields: [parentId], references: [id], onDelete: Cascade)
  /// Student this conversation is about (shared identity with Behavior/Mentoring)
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// general | academic | attendance | behavior | wellbeing | urgent
  category      String    @default("general")
  pinned        Boolean   @default(false)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages  ParentMessage[]
  followUps TeacherFollowUp[]

  @@unique([teacherId, studentId, parentId], name: "parent_conversation_participants")
  @@index([schoolId, teacherId, lastMessageAt])
  @@index([parentId])
}

/// A message inside a parent conversation. `readAt` is set when the
/// RECIPIENT reads it (null = unread by recipient).
model ParentMessage {
  id             String             @id @default(cuid())
  schoolId       String
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   ParentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// User.id of the sender (teacher or parent)
  senderId       String
  sender         User               @relation("ParentMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@index([schoolId, senderId])
}

/// A significant observation about a student — positive recognition,
/// neutral observation or a concern. Sensitive: `privateNote` is
/// teacher/staff-only and is never exposed to parents or students.
model BehaviorRecord {
  id               String    @id @default(cuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// User.id of the recording teacher
  recordedById     String
  recordedBy       User      @relation("BehaviorRecordRecorder", fields: [recordedById], references: [id], onDelete: Cascade)
  date             DateTime
  /// key from BehaviorCategory (school-configurable)
  category         String
  /// positive | observation | concern
  type             String    @default("observation")
  description      String
  actionTaken      String?
  followUpRequired Boolean   @default(false)
  followUpDate     DateTime?
  /// Teacher/staff-only — excluded from any parent/student surface
  privateNote      String?
  /// open | monitoring | resolved
  status           String    @default("open")
  parentNotified   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  followUps TeacherFollowUp[]

  @@index([schoolId, studentId, date])
  @@index([schoolId, recordedById, date])
}

/// School-configurable behavior taxonomy (seeded with defaults; a school
/// can add/rename/deactivate categories without code changes).
model BehaviorCategory {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key       String
  label     String
  /// any | positive | concern — the record form uses this to suggest types
  kind      String   @default("any")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([schoolId, key])
}

/// Unified teacher follow-up queue across the Teacher Hub modules.
/// `kind` routes it to the owning module; the optional refs keep the
/// link to the originating conversation/record.
model TeacherFollowUp {
  id             String              @id @default(cuid())
  schoolId       String
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// User.id of the owning teacher
  teacherId      String
  teacher        User                @relation("TeacherFollowUpTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  /// parent-connect | behavior
  kind           String
  studentId      String?
  student        Student?            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   ParentConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recordId       String?
  record         BehaviorRecord?     @relation(fields: [recordId], references: [id], onDelete: Cascade)
  reason         String
  note           String?
  dueDate        DateTime
  /// low | normal | high
  priority       String              @default("normal")
  /// open | done | cancelled
  status         String              @default("open")
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([schoolId, teacherId, status, dueDate])
  @@index([kind, status])
}

/// School-approved message templates (quick replies in Parent Connect —
/// configurable data, not hardcoded strings).
model MessageTemplate {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// parent-connect | …future kinds
  kind      String   @default("parent-connect")
  label     String
  body      String
  /// general | academic | attendance | behavior | wellbeing
  category  String   @default("general")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([schoolId, kind, isActive])
}

// ─── Teacher Workspace v2.15 — Curriculum & Lesson Planning ─────────────
//
// Architecture (Lesson Planner rework):
//   CurriculumTopic   — the SCHOOL'S curriculum instance for one (class,
//                      subject): ordered units → topics seeded from a real
//                      board structure (CBSE / NCERT). Traceable to its
//                      master-library source via sourceBoard.
//   LessonTopicCompletion — the ONLY persisted planning state: the day a
//                      topic was actually completed (history). The day-wise
//                      schedule itself is DERIVED on read from the school
//                      calendar + timetable pace, so calendar changes
//                      automatically reschedule future topics while past
//                      completions keep their real dates.

model CurriculumTopic {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId       String
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// Master-library traceability (the board structure this instance was
  /// instantiated from — e.g. "CBSE-2026"). Never AI-generated content.
  sourceBoard   String   @default("CBSE")
  unitNo        Int
  unitName      String
  /// Sequential topic number within the subject's curriculum.
  topicNo       Int
  topicName     String
  description   String?
  /// Estimated teaching periods (incl. guided practice & assessment).
  periodsNeeded Int      @default(4)
  orderIndex    Int
  createdAt     DateTime @default(now())

  completions   LessonTopicCompletion[]

  @@unique([classId, subjectId, topicNo])
  @@index([schoolId, classId, subjectId, orderIndex])
}

model LessonTopicCompletion {
  id                String          @id @default(cuid())
  schoolId          String
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  curriculumTopicId String          @unique
  curriculumTopic   CurriculumTopic @relation(fields: [curriculumTopicId], references: [id], onDelete: Cascade)
  classId           String
  subjectId         String
  /// Teacher.id of the teacher who completed the topic.
  teacherId         String
  /// The teaching day the topic was actually completed (history — never
  /// recomputed when the calendar changes).
  completedOn       DateTime
  note              String?
  createdAt         DateTime        @default(now())

  @@index([schoolId, classId, subjectId])
}

// ─── Teacher Workspace v2.15 — Subject Attendance Sessions ────────────
//
// Attendance model (two layers):
//   • Baseline: the CLASS TEACHER'S daily attendance — the existing
//     `Attendance` rows (unique per student+date). This is the school's
//     official daily record and what students/parents see.
//   • Subject sessions: a SUBJECT teacher's own session for a class she
//     teaches (separate, per subject+date+teacher). Opening the roster
//     PREFILLS from the class teacher's baseline — viewing never writes;
//     the teacher explicitly submits her session.

model SubjectAttendanceSession {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  date      DateTime
  createdAt DateTime @default(now())

  entries   SubjectAttendanceEntry[]

  @@unique([classId, subjectId, teacherId, date])
  @@index([schoolId, classId, date])
}

model SubjectAttendanceEntry {
  id        String                   @id @default(cuid())
  sessionId String
  session   SubjectAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// PRESENT | ABSENT | LATE | LEAVE
  status    String

  @@unique([sessionId, studentId])
}
